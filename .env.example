# ==============================================================================
# Zhat Beauty - Environment Configuration (.env.example)
# Official Meta WhatsApp Cloud API Configuration
# ==============================================================================

# Application Server Port
PORT=3000
NODE_ENV=development

# ------------------------------------------------------------------------------
# 1. Official Meta WhatsApp Cloud API Credentials
# Obtained from Meta for Developers (developers.facebook.com)
# ------------------------------------------------------------------------------

# Permanent System User Access Token (or temporary developer token)
# Located in: WhatsApp > API Setup (or Business Settings > System Users)
# Required permissions: whatsapp_business_messaging, whatsapp_business_management
META_WA_ACCESS_TOKEN="EAA..."

# Meta Phone Number ID (from WhatsApp > API Setup, e.g. 109876543210123)
# Note: This is Meta's internal ID for your phone number, NOT the display phone digits.
META_WA_PHONE_NUMBER_ID="109876543210123"

# WhatsApp Business Account ID (WABA ID from WhatsApp > API Setup)
META_WA_BUSINESS_ACCOUNT_ID="123456789012345"

# Webhook Verification Secret Token
# Create any secure alphanumeric string here, then enter the exact same string
# into the "Verify Token" field in Meta App Dashboard > WhatsApp > Configuration.
META_WA_VERIFY_TOKEN="zhat_beauty_secure_webhook_verify_token"

# Meta App Secret (Crucial for X-Hub-Signature-256 HMAC payload verification)
# Located in: Meta for Developers > App Dashboard > App Settings > Basic > App Secret
# Used to cryptographically authenticate that incoming webhooks genuinely originated from Meta.
META_WA_APP_SECRET="your_meta_app_secret_here"

# ------------------------------------------------------------------------------
# 2. Public App / Webhook URL
# ------------------------------------------------------------------------------
# The public HTTPS URL where this application is reachable by Meta's webhook servers.
# Recommended Webhook Endpoint: ${APP_URL}/api/webhooks/whatsapp
# (Also supports legacy path: ${APP_URL}/api/whatsapp/webhook)
APP_URL="https://your-domain.ng"

# ------------------------------------------------------------------------------
# 3. Persistent Database (MongoDB - Optional)
# ------------------------------------------------------------------------------
# If left empty, the application runs seamlessly with high-speed in-memory storage.
# To connect a production database, supply your MongoDB connection string below:
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.mongodb.net/zhatbeauty?retryWrites=true&w=majority"

# ------------------------------------------------------------------------------
# 4. Security
# ------------------------------------------------------------------------------
JWT_SECRET="generate-a-secure-jwt-secret-here"
