# ==============================================================================
# KasuwaDesk - Environment Configuration (.env.example)
# WhatsApp Sales Management System for Nigerian Small Businesses
# ==============================================================================

# Application Port (Defaults to 3000)
PORT=3000
NODE_ENV=development

# ------------------------------------------------------------------------------
# 1. Persistent Database (MongoDB)
# If left empty, KasuwaDesk automatically runs in Demo Mode with isolated seed data.
# ------------------------------------------------------------------------------
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.mongodb.net/kasuwadesk?retryWrites=true&w=majority"

# ------------------------------------------------------------------------------
# 2. Provider A: Unofficial WhatsApp Web Persistent Microservice
# Run the microservice located at /services/whatsapp-web-service on a VPS/Docker.
# ------------------------------------------------------------------------------
WA_WEB_SERVICE_URL="http://localhost:3001"
WA_WEB_SERVICE_KEY="generate-a-strong-random-shared-secret-key"

# ------------------------------------------------------------------------------
# 3. Provider B: Meta WhatsApp Cloud API (Official)
# Obtained from Meta for Developers (developers.facebook.com) > WhatsApp > API Setup
# ------------------------------------------------------------------------------
META_WA_ACCESS_TOKEN="EAA..."
META_WA_PHONE_NUMBER_ID="109876543210123"
META_WA_BUSINESS_ACCOUNT_ID="123456789012345"
META_WA_VERIFY_TOKEN="your-custom-webhook-verify-token-for-meta"

# ------------------------------------------------------------------------------
# 4. Public Webhook & App URL
# ------------------------------------------------------------------------------
APP_URL="https://your-domain.ng"

# ------------------------------------------------------------------------------
# 5. Security & Session Secrets
# ------------------------------------------------------------------------------
JWT_SECRET="generate-a-secure-jwt-secret-here"
